# Copy to .env and adjust values as needed.

# Database connection URL (SQLAlchemy format).
# Defaults to a local SQLite file (./app.db) when unset.
# DATABASE_URL=sqlite:///app.db
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vianalytics

# Secret used to sign JWT access tokens. Required — the app won't start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Directory where uploaded files are stored (created on startup if missing).
# Defaults to ./uploaded_files when unset.
UPLOAD_FOLDER=./uploaded_files

# Comma-separated list of origins allowed to call the API cross-origin.
# Defaults to "*" (any origin) when unset.
CORS_ORIGINS=http://localhost:5173

# Initial admin account created by `python seed.py` (skipped if the email exists).
# SEED_ADMIN_EMAIL defaults to admin@admin.com; SEED_ADMIN_PASSWORD is required for seeding.
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=change-me

# Airflow REST API that processes uploaded files (base URL includes the /airflow prefix).
AIRFLOW_API_URL=http://localhost:8080/airflow
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
